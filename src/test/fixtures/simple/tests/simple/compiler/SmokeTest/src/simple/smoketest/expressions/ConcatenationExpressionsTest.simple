' Tests string concatenation expressions

函数 Name() 为 文本型
	Name = "String Concatenation Expression Tests"
结束 函数

过程 Run()
	' While these don't check that constant folding is done, they do ensure that it is done
	' correctly if it is done at all!
	断言真(HelloWorldString() = "HelloWorld")

	' Simple concatenation
	断言真(SimpleConcat("Hello", "World") = "HelloWorld")
	断言真(4 & 5 = "45")

	' Variant concatenation
	断言真(SimpleConcat("1.5", "2.5") = "1.52.5")

	' Complex concatenation
	断言真(ComplexConcat("Hello", "World", 4, 5) = "Hello9World")
结束 过程

函数 HelloWorldString() 为 文本型
	HelloWorldString = "Hello" & "World"
结束 函数

函数 SimpleConcat(s1 为 文本型, s2 为 文本型) 为 文本型
	SimpleConcat = s1 & s2
结束 函数

函数 VariantConcat(v1 为 变体型, v2 为 变体型) 为 文本型
	VariantConcat = v1 & v2
结束 函数

函数 ComplexConcat(s1 为 文本型, s2 为 文本型, e1 为 整数型, e2 为 整数型) 为 文本型
	ComplexConcat = s1 & e1 + e2 & s2
结束 函数

$属性
	$资源 $对象
	实现接口 = simple.smoketest.Test
$结束 $属性
