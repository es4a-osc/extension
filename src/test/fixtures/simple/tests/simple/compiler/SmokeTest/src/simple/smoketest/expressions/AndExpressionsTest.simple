' Tests logical and bitwise And expressions

' The following constants are used as return values for the functions testing logical expressions
' within branch statements indicating which statement block was actually executed.
常量 NONE 为 文本型 = "None"
常量 TRUE 为 文本型 = "True"
常量 FALSE 为 文本型 = "False"

' For side-effect during short-circuit evaluation
变量 sideEffect 为 逻辑型

函数 Name() 为 文本型
	Name = "And Expression Tests"
结束 函数

过程 Run()
	' Bitwise And
	' While these don't check that constant folding is done, they do ensure that it is done
	' correctly if it is done at all!
	断言真(FourInteger() = &H4)

	' Simple bitwise And
	断言真(SimpleAndInteger(&HFF, &H88) = &H88)
	断言真(SimpleAndLong(&HFFFFFFFFFFFF, &H800080008000) = &H800080008000)
	断言真(SimpleAndVariant(&HFF, &H88) = &H88)
	断言真(SimpleAndVariant(&HFFFFFFFFFFFF, &H800080008000) = &H800080008000)

	' Complex bitwise And
	断言真(ComplexAndInteger(&HFF, &H88) = &H7)
	断言真(ComplexAndLong(&HFFFFFFFFFFFF, &H800880088800) = &H7FF)
	断言真(ComplexAndVariant(&HFF, &H88) = &H7)

	' Logical And
	' While these don't check that constant folding is done, they do ensure that it is done
	' correctly if it is done at all!
	断言真(TrueTrueBoolean())
	断言假(TrueFalseBoolean())
	断言假(FalseTrueBoolean())
	断言假(FalseFalseBoolean())

	' Simple logical And
	断言真(SimpleAndBoolean(真, 真))
	断言假(SimpleAndBoolean(真, 假))
	断言假(SimpleAndBoolean(假, 真))
	断言假(SimpleAndBoolean(假, 假))

	断言真(SimpleAndBooleanWithBranchOnFalse(真, 真) = TRUE)
	断言真(SimpleAndBooleanWithBranchOnFalse(真, 假) = FALSE)
	断言真(SimpleAndBooleanWithBranchOnFalse(假, 真) = FALSE)
	断言真(SimpleAndBooleanWithBranchOnFalse(假, 假) = FALSE)

	断言真(SimpleAndBooleanWithBranchOnTrue(真, 真) = TRUE)
	断言真(SimpleAndBooleanWithBranchOnTrue(真, 假) = FALSE)
	断言真(SimpleAndBooleanWithBranchOnTrue(假, 真) = FALSE)
	断言真(SimpleAndBooleanWithBranchOnTrue(假, 假) = FALSE)

	' Complex logical And
	断言假(ComplexAndBoolean(真, 真))
	断言假(ComplexAndBoolean(真, 假))
	断言真(ComplexAndBoolean(假, 真))
	断言假(ComplexAndBoolean(假, 假))

	断言真(ComplexAndBooleanWithBranch(真, 真) = FALSE)
	断言真(ComplexAndBooleanWithBranch(真, 假) = FALSE)
	断言真(ComplexAndBooleanWithBranch(假, 真) = TRUE)
	断言真(ComplexAndBooleanWithBranch(假, 假) = FALSE)

	' Short curcuit evaluation
	sideEffect = 假 : CheckShortCurcuitEvaluation(假) : 断言假(sideEffect)
结束 过程

函数 FourInteger() 为 整数型
	FourInteger = &H4 且 &H4
结束 函数

函数 SimpleAndInteger(e1 为 整数型, e2 为 整数型) 为 整数型
	SimpleAndInteger = e1 且 e2
结束 函数

函数 SimpleAndLong(e1 为 长整数型, e2 为 长整数型) 为 长整数型
	SimpleAndLong = e1 且 e2
结束 函数

函数 SimpleAndVariant(e1 为 变体型, e2 为 变体型) 为 变体型
	SimpleAndVariant = e1 且 e2
结束 函数

函数 ComplexAndInteger(e1 为 整数型, e2 为 整数型) 为 整数型
	ComplexAndInteger = e1 + e2 且 e1 - e2
结束 函数

函数 ComplexAndLong(e1 为 长整数型, e2 为 长整数型) 为 长整数型
	ComplexAndLong = e1 + e2 且 e1 - e2
结束 函数

函数 ComplexAndVariant(e1 为 变体型, e2 为 变体型) 为 变体型
	ComplexAndVariant = e1 + e2 且 e1 - e2
结束 函数

函数 TrueTrueBoolean() 为 逻辑型
	TrueTrueBoolean = 真 且 真
结束 函数

函数 TrueFalseBoolean() 为 逻辑型
	TrueFalseBoolean = 真 且 假
结束 函数

函数 FalseTrueBoolean() 为 逻辑型
	FalseTrueBoolean = 假 且 真
结束 函数

函数 FalseFalseBoolean() 为 逻辑型
	FalseFalseBoolean = 假 且 假
结束 函数

函数 SimpleAndBoolean(e1 为 逻辑型, e2 为 逻辑型) 为 逻辑型
	SimpleAndBoolean = e1 且 e2
结束 函数

函数 SimpleAndBooleanWithBranchOnFalse(e1 为 逻辑型, e2 为 逻辑型) 为 文本型
	SimpleAndBooleanWithBranchOnFalse = NONE
	如果 e1 且 e2 则
		SimpleAndBooleanWithBranchOnFalse = TRUE
	否则
		SimpleAndBooleanWithBranchOnFalse = FALSE
	结束 如果
结束 函数

函数 SimpleAndBooleanWithBranchOnTrue(e1 为 逻辑型, e2 为 逻辑型) 为 文本型
	SimpleAndBooleanWithBranchOnTrue = NONE
	变量 return 为 逻辑型
	执行
		如果 return 则
			SimpleAndBooleanWithBranchOnTrue = TRUE
			退出 函数
		结束 如果
		return = 真
	判断循环 e1 且 e2
	SimpleAndBooleanWithBranchOnTrue = FALSE
结束 函数

函数 ComplexAndBoolean(e1 为 逻辑型, e2 为 逻辑型) 为 逻辑型
	ComplexAndBoolean = 取反 e1 或 e2 且 e1 异或 e2
结束 函数

函数 ComplexAndBooleanWithBranch(e1 为 逻辑型, e2 为 逻辑型) 为 文本型
	ComplexAndBooleanWithBranch = NONE
	如果 取反 e1 或 e2 且 e1 异或 e2 则
		ComplexAndBooleanWithBranch = TRUE
	否则
		ComplexAndBooleanWithBranch = FALSE
	结束 如果
结束 函数

函数 CheckShortCurcuitEvaluation(e 为 逻辑型) 为 逻辑型
	CheckShortCurcuitEvaluation = e 且 FunctionWithSideEffect()
结束 函数

函数 FunctionWithSideEffect() 为 逻辑型
	sideEffect = 真
	FunctionWithSideEffect = 真
结束 函数

$属性
	$资源 $对象
	实现接口 = simple.smoketest.Test
$结束 $属性
