' Tests integer divison expressions

函数 Name() 为 文本型
	Name = "Integer Division Expression Tests"
结束 函数

过程 Run()
	' Division of constants
	' While these don't check that constant folding is done, they do ensure that it is done
	' correctly if it is done at all!
	断言真(FourInteger() = 4)
	断言真(FourDouble() = 4)

	' Simple integer divisions
	断言真(SimpleIntegerDivideInteger(12, 3) = 4)
	断言真(SimpleIntegerDivideLong(12, 3) = 4)
	断言真(SimpleIntegerDivideSingle(12.1, 3.0) = 4)
	断言真(SimpleIntegerDivideDouble(12.1, 3.0) = 4)
	断言真(SimpleIntegerDivideVariant(12.1, 3.0) = 4)
	断言真(SimpleIntegerDivideString("12.1", "3.0") = 4)

	' Complex integer divisions
	断言真(ComplexIntegerDivideInteger(12, 3) = 115)
	断言真(ComplexIntegerDivideLong(12, 3) = 115)
	断言真(ComplexIntegerDivideSingle(12.1, 3.0) = 115)
	断言真(ComplexIntegerDivideDouble(12.1, 3.0) = 115)
	断言真(ComplexIntegerDivideVariant(12.1, 3.0) = 115)
结束 过程

函数 FourInteger() 为 整数型
	FourInteger = 9 \ 2
结束 函数

函数 FourDouble() 为 整数型
	FourDouble = 9.2 \ 2.0
结束 函数

函数 SimpleIntegerDivideInteger(e1 为 整数型, e2 为 整数型) 为 整数型
	SimpleIntegerDivideInteger = e1 \ e2
结束 函数

函数 SimpleIntegerDivideLong(e1 为 长整数型, e2 为 长整数型) 为 整数型
	SimpleIntegerDivideLong = e1 \ e2
结束 函数

函数 SimpleIntegerDivideSingle(e1 为 单精度小数型, e2 为 单精度小数型) 为 整数型
	SimpleIntegerDivideSingle = e1 \ e2
结束 函数

函数 SimpleIntegerDivideDouble(e1 为 双精度小数型, e2 为 双精度小数型) 为 整数型
	SimpleIntegerDivideDouble = e1 \ e2
结束 函数

函数 SimpleIntegerDivideString(e1 为 文本型, e2 为 文本型) 为 整数型
	SimpleIntegerDivideString = e1 \ e2
结束 函数

函数 SimpleIntegerDivideVariant(e1 为 变体型, e2 为 变体型) 为 整数型
	SimpleIntegerDivideVariant = e1 \ e2
结束 函数

函数 ComplexIntegerDivideInteger(e1 为 整数型, e2 为 整数型) 为 整数型
	ComplexIntegerDivideInteger = e1 \ e2 * e2 + ("1" & "2" + e1)
结束 函数

函数 ComplexIntegerDivideLong(e1 为 长整数型, e2 为 长整数型) 为 整数型
	ComplexIntegerDivideLong = e1 \ e2 * e2 + ("1" & "2" + e1)
结束 函数

函数 ComplexIntegerDivideSingle(e1 为 单精度小数型, e2 为 单精度小数型) 为 整数型
	ComplexIntegerDivideSingle = e1 \ e2 * e2 + ("1" & "2" + e1)
结束 函数

函数 ComplexIntegerDivideDouble(e1 为 双精度小数型, e2 为 双精度小数型) 为 整数型
	ComplexIntegerDivideDouble = e1 \ e2 * e2 + ("1" & "2" + e1)
结束 函数

函数 ComplexIntegerDivideVariant(e1 为 变体型, e2 为 变体型) 为 整数型
	ComplexIntegerDivideVariant = e1 \ e2 * e2 + ("1" & "2" + e1)
结束 函数

$属性
	$资源 $对象
	实现接口 = simple.smoketest.Test
$结束 $属性
