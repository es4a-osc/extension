' Tests results of converting Longs into other types.

常量 MIN_LONG 为 长整数型 = -9223372036854775808
常量 MAX_LONG 为 长整数型 = 9223372036854775807

函数 Name() 为 文本型
	Name = "Long Conversion Tests"
结束 函数

过程 Run()
	' Long to Boolean
	断言真(ConvertToBoolean(MIN_LONG - 1))
	断言真(ConvertToBoolean(MIN_LONG))
	断言假(ConvertToBoolean(0))
	断言真(ConvertToBoolean(MAX_LONG))
	断言真(ConvertToBoolean(MAX_LONG + 1))

	' Long to Byte
	断言真(ConvertToByte(MIN_LONG - 1) = -1)
	断言真(ConvertToByte(MIN_LONG) = 0)
	断言真(ConvertToByte(0) = 0)
	断言真(ConvertToByte(MAX_LONG) = -1)
	断言真(ConvertToByte(MAX_LONG + 1) = 0)

	' Long to Short
	断言真(ConvertToShort(MIN_LONG - 1) = -1)
	断言真(ConvertToShort(MIN_LONG) = 0)
	断言真(ConvertToShort(0) = 0)
	断言真(ConvertToShort(MAX_LONG) = -1)
	断言真(ConvertToShort(MAX_LONG + 1) = 0)

	' Long to Integer
	断言真(ConvertToInteger(MIN_LONG - 1) = -1)
	断言真(ConvertToInteger(MIN_LONG) = 0)
	断言真(ConvertToInteger(0) = 0)
	断言真(ConvertToInteger(MAX_LONG) = -1)
	断言真(ConvertToInteger(MAX_LONG + 1) = 0)

	' Long to Long
	断言真(ConvertToLong(MIN_LONG - 1) = MAX_LONG)
	断言真(ConvertToLong(MIN_LONG) = MIN_LONG)
	断言真(ConvertToLong(0) = 0)
	断言真(ConvertToLong(MAX_LONG) = MAX_LONG)
	断言真(ConvertToLong(MAX_LONG + 1) = MIN_LONG)

	' Long to Single
	断言真(ConvertToSingle(MIN_LONG - 1) = MAX_LONG)
	断言真(ConvertToSingle(MIN_LONG) = MIN_LONG)
	断言真(ConvertToSingle(0) = 0)
	断言真(ConvertToSingle(MAX_LONG) = MAX_LONG)
	断言真(ConvertToSingle(MAX_LONG + 1) = MIN_LONG)

	' Long to Double
	断言真(ConvertToDouble(MIN_LONG - 1) = MAX_LONG)
	断言真(ConvertToDouble(MIN_LONG) = MIN_LONG)
	断言真(ConvertToDouble(0) = 0)
	断言真(ConvertToDouble(MAX_LONG) = MAX_LONG)
	断言真(ConvertToDouble(MAX_LONG + 1) = MIN_LONG)

	' Long to String
	断言真(ConvertToString(MIN_LONG - 1) = "9223372036854775807")
	断言真(ConvertToString(MIN_LONG) = "-9223372036854775808")
	断言真(ConvertToString(0) = "0")
	断言真(ConvertToString(MAX_LONG) = "9223372036854775807")
	断言真(ConvertToString(MAX_LONG + 1) = "-9223372036854775808")

	' Long to Variant
	断言真(ConvertToVariant(MIN_LONG - 1) = MAX_LONG)
	断言真(ConvertToVariant(MIN_LONG) = MIN_LONG)
	断言真(ConvertToVariant(0) = 0)
	断言真(ConvertToVariant(MAX_LONG) = MAX_LONG)
	断言真(ConvertToVariant(MAX_LONG + 1) = MIN_LONG)
结束 过程

函数 ConvertToBoolean(value 为 长整数型) 为 逻辑型
	ConvertToBoolean = value
结束 函数

函数 ConvertToByte(value 为 长整数型) 为 字节型
	ConvertToByte = value
结束 函数

函数 ConvertToShort(value 为 长整数型) 为 短整数型
	ConvertToShort = value
结束 函数

函数 ConvertToInteger(value 为 长整数型) 为 整数型
	ConvertToInteger = value
结束 函数

函数 ConvertToLong(value 为 长整数型) 为 长整数型
	ConvertToLong = value
结束 函数

函数 ConvertToSingle(value 为 长整数型) 为 单精度小数型
	ConvertToSingle = value
结束 函数

函数 ConvertToDouble(value 为 长整数型) 为 双精度小数型
	ConvertToDouble = value
结束 函数

函数 ConvertToString(value 为 长整数型) 为 文本型
	ConvertToString = value
结束 函数

函数 ConvertToVariant(value 为 长整数型) 为 变体型
	ConvertToVariant = value
结束 函数

$属性
	$资源 $对象
	实现接口 = simple.smoketest.Test
$结束 $属性
