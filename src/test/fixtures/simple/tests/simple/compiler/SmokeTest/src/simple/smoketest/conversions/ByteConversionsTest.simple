' Tests results of converting Bytes into other types.

常量 MIN_BYTE 为 短整数型 = -128
常量 MAX_BYTE 为 短整数型 = 127

函数 Name() 为 文本型
	Name = "Byte Conversion Tests"
结束 函数

过程 Run()
	' Byte to Boolean
	断言真(ConvertToBoolean(MIN_BYTE - 1))
	断言真(ConvertToBoolean(MIN_BYTE))
	断言假(ConvertToBoolean(0))
	断言真(ConvertToBoolean(MAX_BYTE))
	断言真(ConvertToBoolean(MAX_BYTE + 1))

	' Byte to Byte
	断言真(ConvertToByte(MIN_BYTE - 1) = MAX_BYTE)
	断言真(ConvertToByte(MIN_BYTE) = MIN_BYTE)
	断言真(ConvertToByte(0) = 0)
	断言真(ConvertToByte(MAX_BYTE) = MAX_BYTE)
	断言真(ConvertToByte(MAX_BYTE + 1) = MIN_BYTE)

	' Byte to Short
	断言真(ConvertToShort(MIN_BYTE - 1) = MAX_BYTE)
	断言真(ConvertToShort(MIN_BYTE) = MIN_BYTE)
	断言真(ConvertToShort(0) = 0)
	断言真(ConvertToShort(MAX_BYTE) = MAX_BYTE)
	断言真(ConvertToShort(MAX_BYTE + 1) = MIN_BYTE)

	' Byte to Integer
	断言真(ConvertToInteger(MIN_BYTE - 1) = MAX_BYTE)
	断言真(ConvertToInteger(MIN_BYTE) = MIN_BYTE)
	断言真(ConvertToInteger(0) = 0)
	断言真(ConvertToInteger(MAX_BYTE) = MAX_BYTE)
	断言真(ConvertToInteger(MAX_BYTE + 1) = MIN_BYTE)

	' Byte to Long
	断言真(ConvertToLong(MIN_BYTE - 1) = MAX_BYTE)
	断言真(ConvertToLong(MIN_BYTE) = MIN_BYTE)
	断言真(ConvertToLong(0) = 0)
	断言真(ConvertToLong(MAX_BYTE) = MAX_BYTE)
	断言真(ConvertToLong(MAX_BYTE + 1) = MIN_BYTE)

	' Byte to Single
	断言真(ConvertToSingle(MIN_BYTE - 1) = MAX_BYTE)
	断言真(ConvertToSingle(MIN_BYTE) = MIN_BYTE)
	断言真(ConvertToSingle(0) = 0)
	断言真(ConvertToSingle(MAX_BYTE) = MAX_BYTE)
	断言真(ConvertToSingle(MAX_BYTE + 1) = MIN_BYTE)

	' Byte to Double
	断言真(ConvertToDouble(MIN_BYTE - 1) = MAX_BYTE)
	断言真(ConvertToDouble(MIN_BYTE) = MIN_BYTE)
	断言真(ConvertToDouble(0) = 0)
	断言真(ConvertToDouble(MAX_BYTE) = MAX_BYTE)
	断言真(ConvertToDouble(MAX_BYTE + 1) = MIN_BYTE)

	' Byte to String
	断言真(ConvertToString(MIN_BYTE - 1) = "127")
	断言真(ConvertToString(MIN_BYTE) = "-128")
	断言真(ConvertToString(0) = "0")
	断言真(ConvertToString(MAX_BYTE) = "127")
	断言真(ConvertToString(MAX_BYTE + 1) = "-128")

	' Byte to Variant
	断言真(ConvertToVariant(MIN_BYTE - 1) = MAX_BYTE)
	断言真(ConvertToVariant(MIN_BYTE) = MIN_BYTE)
	断言真(ConvertToVariant(0) = 0)
	断言真(ConvertToVariant(MAX_BYTE) = MAX_BYTE)
	断言真(ConvertToVariant(MAX_BYTE + 1) = MIN_BYTE)
结束 过程

函数 ConvertToBoolean(value 为 字节型) 为 逻辑型
	ConvertToBoolean = value
结束 函数

函数 ConvertToByte(value 为 字节型) 为 字节型
	ConvertToByte = value
结束 函数

函数 ConvertToShort(value 为 字节型) 为 短整数型
	ConvertToShort = value
结束 函数

函数 ConvertToInteger(value 为 字节型) 为 整数型
	ConvertToInteger = value
结束 函数

函数 ConvertToLong(value 为 字节型) 为 长整数型
	ConvertToLong = value
结束 函数

函数 ConvertToSingle(value 为 字节型) 为 单精度小数型
	ConvertToSingle = value
结束 函数

函数 ConvertToDouble(value 为 字节型) 为 双精度小数型
	ConvertToDouble = value
结束 函数

函数 ConvertToString(value 为 字节型) 为 文本型
	ConvertToString = value
结束 函数

函数 ConvertToVariant(value 为 字节型) 为 变体型
	ConvertToVariant = value
结束 函数

$属性
	$资源 $对象
	实现接口 = simple.smoketest.Test
$结束 $属性
