' Tests unary + and - expressions

' Don't use POSITIVE_VALUE to define NEGATIVE_VALUE! Don't use zero for the value
常量 POSITIVE_VALUE 为 整数型 = 2
常量 NEGATIVE_VALUE 为 整数型 = -2

函数 Name() 为 文本型
	Name = "Identity Expression Tests"
结束 函数

过程 Run()
	断言真(0 = 0)
	断言真(0 = +0)
	断言真(0 = -0)

	断言真(POSITIVE_VALUE = POSITIVE_VALUE)
	断言真(POSITIVE_VALUE <> NEGATIVE_VALUE)
	断言真(POSITIVE_VALUE = +POSITIVE_VALUE)
	断言真(POSITIVE_VALUE = -NEGATIVE_VALUE)

	断言真(PositiveValue() = +PositiveValue())
	断言真(PositiveValue() = -NegativeValue())

	断言真(-4 = -2 ^ 2)
	断言真(0 = -2 + 2)
	断言真(-4 = -(2 + 2))
	断言真(0 = 2 + -2)
结束 过程

函数 PositiveValue() 为 整数型
	PositiveValue = POSITIVE_VALUE
结束 函数

函数 NegativeValue() 为 整数型
	NegativeValue = NEGATIVE_VALUE
结束 函数

$属性
	$资源 $对象
	实现接口 = simple.smoketest.Test
$结束 $属性
