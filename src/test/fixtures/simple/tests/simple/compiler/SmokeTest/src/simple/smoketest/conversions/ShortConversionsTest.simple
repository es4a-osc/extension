' Tests results of converting Shorts into other types.

常量 MIN_SHORT 为 短整数型 = -32768
常量 MAX_SHORT 为 短整数型 = 32767

函数 Name() 为 文本型
	Name = "Short Conversion Tests"
结束 函数

过程 Run()
	' Short to Boolean
	断言真(ConvertToBoolean(MIN_SHORT - 1))
	断言真(ConvertToBoolean(MIN_SHORT))
	断言假(ConvertToBoolean(0))
	断言真(ConvertToBoolean(MAX_SHORT))
	断言真(ConvertToBoolean(MAX_SHORT + 1))

	' Short to Byte
	断言真(ConvertToByte(MIN_SHORT - 1) = -1)
	断言真(ConvertToByte(MIN_SHORT) = 0)
	断言真(ConvertToByte(0) = 0)
	断言真(ConvertToByte(MAX_SHORT) = -1)
	断言真(ConvertToByte(MAX_SHORT + 1) = 0)

	' Short to Short
	断言真(ConvertToShort(MIN_SHORT - 1) = MAX_SHORT)
	断言真(ConvertToShort(MIN_SHORT) = MIN_SHORT)
	断言真(ConvertToShort(0) = 0)
	断言真(ConvertToShort(MAX_SHORT) = MAX_SHORT)
	断言真(ConvertToShort(MAX_SHORT + 1) = MIN_SHORT)

	' Short to Integer
	断言真(ConvertToInteger(MIN_SHORT - 1) = MAX_SHORT)
	断言真(ConvertToInteger(MIN_SHORT) = MIN_SHORT)
	断言真(ConvertToInteger(0) = 0)
	断言真(ConvertToInteger(MAX_SHORT) = MAX_SHORT)
	断言真(ConvertToInteger(MAX_SHORT + 1) = MIN_SHORT)

	' Short to Long
	断言真(ConvertToLong(MIN_SHORT - 1) = MAX_SHORT)
	断言真(ConvertToLong(MIN_SHORT) = MIN_SHORT)
	断言真(ConvertToLong(0) = 0)
	断言真(ConvertToLong(MAX_SHORT) = MAX_SHORT)
	断言真(ConvertToLong(MAX_SHORT + 1) = MIN_SHORT)

	' Short to Single
	断言真(ConvertToSingle(MIN_SHORT - 1) = MAX_SHORT)
	断言真(ConvertToSingle(MIN_SHORT) = MIN_SHORT)
	断言真(ConvertToSingle(0) = 0)
	断言真(ConvertToSingle(MAX_SHORT) = MAX_SHORT)
	断言真(ConvertToSingle(MAX_SHORT + 1) = MIN_SHORT)

	' Short to Double
	断言真(ConvertToDouble(MIN_SHORT - 1) = MAX_SHORT)
	断言真(ConvertToDouble(MIN_SHORT) = MIN_SHORT)
	断言真(ConvertToDouble(0) = 0)
	断言真(ConvertToDouble(MAX_SHORT) = MAX_SHORT)
	断言真(ConvertToDouble(MAX_SHORT + 1) = MIN_SHORT)

	' Short to String
	断言真(ConvertToString(MIN_SHORT - 1) = "32767")
	断言真(ConvertToString(MIN_SHORT) = "-32768")
	断言真(ConvertToString(0) = "0")
	断言真(ConvertToString(MAX_SHORT) = "32767")
	断言真(ConvertToString(MAX_SHORT + 1) = "-32768")

	' Short to Variant
	断言真(ConvertToVariant(MIN_SHORT - 1) = MAX_SHORT)
	断言真(ConvertToVariant(MIN_SHORT) = MIN_SHORT)
	断言真(ConvertToVariant(0) = 0)
	断言真(ConvertToVariant(MAX_SHORT) = MAX_SHORT)
	断言真(ConvertToVariant(MAX_SHORT + 1) = MIN_SHORT)
结束 过程

函数 ConvertToBoolean(value 为 短整数型) 为 逻辑型
	ConvertToBoolean = value
结束 函数

函数 ConvertToByte(value 为 短整数型) 为 字节型
	ConvertToByte = value
结束 函数

函数 ConvertToShort(value 为 短整数型) 为 短整数型
	ConvertToShort = value
结束 函数

函数 ConvertToInteger(value 为 短整数型) 为 整数型
	ConvertToInteger = value
结束 函数

函数 ConvertToLong(value 为 短整数型) 为 长整数型
	ConvertToLong = value
结束 函数

函数 ConvertToSingle(value 为 短整数型) 为 单精度小数型
	ConvertToSingle = value
结束 函数

函数 ConvertToDouble(value 为 短整数型) 为 双精度小数型
	ConvertToDouble = value
结束 函数

函数 ConvertToString(value 为 短整数型) 为 文本型
	ConvertToString = value
结束 函数

函数 ConvertToVariant(value 为 短整数型) 为 变体型
	ConvertToVariant = value
结束 函数

$属性
	$资源 $对象
	实现接口 = simple.smoketest.Test
$结束 $属性
