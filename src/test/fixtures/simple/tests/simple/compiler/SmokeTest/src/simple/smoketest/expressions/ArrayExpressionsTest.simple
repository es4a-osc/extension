	断言真(InstanceDataMemberMultiDimensionBoolean(0, 0) = FIRST_BOOLEAN_ELEMENT)
	断言真(InstanceDataMemberMultiDimensionBoolean(1, 1) = SECOND_BOOLEAN_ELEMENT)

	断言真(InstanceDataMemberMultiDimensionByte(0, 0) = FIRST_BYTE_ELEMENT)
	断言真(InstanceDataMemberMultiDimensionByte(1, 1) = SECOND_BYTE_ELEMENT)

	断言真(InstanceDataMemberMultiDimensionShort(0, 0) = FIRST_SHORT_ELEMENT)
	断言真(InstanceDataMemberMultiDimensionShort(1, 1) = SECOND_SHORT_ELEMENT)

	断言真(InstanceDataMemberMultiDimensionInteger(0, 0) = FIRST_INTEGER_ELEMENT)
