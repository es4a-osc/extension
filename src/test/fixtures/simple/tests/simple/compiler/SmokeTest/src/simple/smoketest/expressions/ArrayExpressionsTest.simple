过程 Run()
	' Checks array read/write access to a single dimension local static array
	断言真(LocalSingleDimensionBoolean(0) = FIRST_BOOLEAN_ELEMENT)
	断言真(LocalSingleDimensionBoolean(1) = SECOND_BOOLEAN_ELEMENT)

	断言真(LocalSingleDimensionByte(0) = FIRST_BYTE_ELEMENT)
	断言真(LocalSingleDimensionByte(1) = SECOND_BYTE_ELEMENT)

	断言真(LocalSingleDimensionShort(0) = FIRST_SHORT_ELEMENT)
	断言真(LocalSingleDimensionShort(1) = SECOND_SHORT_ELEMENT)

	断言真(LocalSingleDimensionInteger(0) = FIRST_INTEGER_ELEMENT)
	断言真(LocalSingleDimensionInteger(1) = SECOND_INTEGER_ELEMENT)

	断言真(LocalSingleDimensionLong(0) = FIRST_LONG_ELEMENT)
	断言真(LocalSingleDimensionLong(1) = SECOND_LONG_ELEMENT)

	断言真(LocalSingleDimensionSingle(0) = FIRST_SINGLE_ELEMENT)
	断言真(LocalSingleDimensionSingle(1) = SECOND_SINGLE_ELEMENT)

	断言真(LocalSingleDimensionDouble(0) = FIRST_DOUBLE_ELEMENT)
	断言真(LocalSingleDimensionDouble(1) = SECOND_DOUBLE_ELEMENT)

	断言真(LocalSingleDimensionString(0) = FIRST_STRING_ELEMENT)
	断言真(LocalSingleDimensionString(1) = SECOND_STRING_ELEMENT)

	' Checks array read/write access to a multi dimension local static array
	断言真(LocalMultiDimensionBoolean(0, 0) = FIRST_BOOLEAN_ELEMENT)
	断言真(LocalMultiDimensionBoolean(1, 1) = SECOND_BOOLEAN_ELEMENT)

	断言真(LocalMultiDimensionByte(0, 0) = FIRST_BYTE_ELEMENT)
	断言真(LocalMultiDimensionByte(1, 1) = SECOND_BYTE_ELEMENT)

	断言真(LocalMultiDimensionShort(0, 0) = FIRST_SHORT_ELEMENT)
	断言真(LocalMultiDimensionShort(1, 1) = SECOND_SHORT_ELEMENT)

	断言真(LocalMultiDimensionInteger(0, 0) = FIRST_INTEGER_ELEMENT)
	断言真(LocalMultiDimensionInteger(1, 1) = SECOND_INTEGER_ELEMENT)

	断言真(LocalMultiDimensionLong(0, 0) = FIRST_LONG_ELEMENT)
	断言真(LocalMultiDimensionLong(1, 1) = SECOND_LONG_ELEMENT)

	断言真(LocalMultiDimensionSingle(0, 0) = FIRST_SINGLE_ELEMENT)
	断言真(LocalMultiDimensionSingle(1, 1) = SECOND_SINGLE_ELEMENT)

	断言真(LocalMultiDimensionDouble(0, 0) = FIRST_DOUBLE_ELEMENT)
	断言真(LocalMultiDimensionDouble(1, 1) = SECOND_DOUBLE_ELEMENT)

	断言真(LocalMultiDimensionString(0, 0) = FIRST_STRING_ELEMENT)
	断言真(LocalMultiDimensionString(1, 1) = SECOND_STRING_ELEMENT)

	' Checks array read/write access to a single dimension instance data member static array
	断言真(InstanceDataMemberSingleDimensionBoolean(0) = FIRST_BOOLEAN_ELEMENT)
	断言真(InstanceDataMemberSingleDimensionBoolean(1) = SECOND_BOOLEAN_ELEMENT)

	断言真(InstanceDataMemberSingleDimensionByte(0) = FIRST_BYTE_ELEMENT)
	断言真(InstanceDataMemberSingleDimensionByte(1) = SECOND_BYTE_ELEMENT)

	断言真(InstanceDataMemberSingleDimensionShort(0) = FIRST_SHORT_ELEMENT)
	断言真(InstanceDataMemberSingleDimensionShort(1) = SECOND_SHORT_ELEMENT)

	断言真(InstanceDataMemberSingleDimensionInteger(0) = FIRST_INTEGER_ELEMENT)
	断言真(InstanceDataMemberSingleDimensionInteger(1) = SECOND_INTEGER_ELEMENT)

	断言真(InstanceDataMemberSingleDimensionLong(0) = FIRST_LONG_ELEMENT)
	断言真(InstanceDataMemberSingleDimensionLong(1) = SECOND_LONG_ELEMENT)

	断言真(InstanceDataMemberSingleDimensionSingle(0) = FIRST_SINGLE_ELEMENT)
