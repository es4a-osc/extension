	' Checks array read/write access to a single dimension object data member static array
	断言真(ObjectDataMemberSingleDimensionBoolean(0) = FIRST_BOOLEAN_ELEMENT)
	断言真(ObjectDataMemberSingleDimensionBoolean(1) = SECOND_BOOLEAN_ELEMENT)

	断言真(ObjectDataMemberSingleDimensionByte(0) = FIRST_BYTE_ELEMENT)
	断言真(ObjectDataMemberSingleDimensionByte(1) = SECOND_BYTE_ELEMENT)

	断言真(ObjectDataMemberSingleDimensionShort(0) = FIRST_SHORT_ELEMENT)
	断言真(ObjectDataMemberSingleDimensionShort(1) = SECOND_SHORT_ELEMENT)

	断言真(ObjectDataMemberSingleDimensionInteger(0) = FIRST_INTEGER_ELEMENT)
	断言真(ObjectDataMemberSingleDimensionInteger(1) = SECOND_INTEGER_ELEMENT)

	断言真(ObjectDataMemberSingleDimensionLong(0) = FIRST_LONG_ELEMENT)
	断言真(ObjectDataMemberSingleDimensionLong(1) = SECOND_LONG_ELEMENT)

	断言真(ObjectDataMemberSingleDimensionSingle(0) = FIRST_SINGLE_ELEMENT)
	断言真(ObjectDataMemberSingleDimensionSingle(1) = SECOND_SINGLE_ELEMENT)

	断言真(ObjectDataMemberSingleDimensionDouble(0) = FIRST_DOUBLE_ELEMENT)
	断言真(ObjectDataMemberSingleDimensionDouble(1) = SECOND_DOUBLE_ELEMENT)

	断言真(ObjectDataMemberSingleDimensionString(0) = FIRST_STRING_ELEMENT)
	断言真(ObjectDataMemberSingleDimensionString(1) = SECOND_STRING_ELEMENT)

	' Checks array read/write access to a multi dimension object data member static array
	断言真(ObjectDataMemberMultiDimensionBoolean(0, 0) = FIRST_BOOLEAN_ELEMENT)
	断言真(ObjectDataMemberMultiDimensionBoolean(1, 1) = SECOND_BOOLEAN_ELEMENT)

	断言真(ObjectDataMemberMultiDimensionByte(0, 0) = FIRST_BYTE_ELEMENT)
	断言真(ObjectDataMemberMultiDimensionByte(1, 1) = SECOND_BYTE_ELEMENT)

	断言真(ObjectDataMemberMultiDimensionShort(0, 0) = FIRST_SHORT_ELEMENT)
	断言真(ObjectDataMemberMultiDimensionShort(1, 1) = SECOND_SHORT_ELEMENT)

	断言真(ObjectDataMemberMultiDimensionInteger(0, 0) = FIRST_INTEGER_ELEMENT)
	断言真(ObjectDataMemberMultiDimensionInteger(1, 1) = SECOND_INTEGER_ELEMENT)

	断言真(ObjectDataMemberMultiDimensionLong(0, 0) = FIRST_LONG_ELEMENT)
	断言真(ObjectDataMemberMultiDimensionLong(1, 1) = SECOND_LONG_ELEMENT)

	断言真(ObjectDataMemberMultiDimensionSingle(0, 0) = FIRST_SINGLE_ELEMENT)
	断言真(ObjectDataMemberMultiDimensionSingle(1, 1) = SECOND_SINGLE_ELEMENT)

	断言真(ObjectDataMemberMultiDimensionDouble(0, 0) = FIRST_DOUBLE_ELEMENT)
	断言真(ObjectDataMemberMultiDimensionDouble(1, 1) = SECOND_DOUBLE_ELEMENT)

	断言真(ObjectDataMemberMultiDimensionString(0, 0) = FIRST_STRING_ELEMENT)
	断言真(ObjectDataMemberMultiDimensionString(1, 1) = SECOND_STRING_ELEMENT)

	' Checking dynamically sized array usage
	变量 singleDimArray2 为 整数型(2)
	SingleDimensionArray = singleDimArray2
	断言真(SingleDimensionArray 是 singleDimArray2)

	变量 multiDimArray21 为 整数型(2, 1)
	MultiDimensionArray = multiDimArray21
	断言真(MultiDimensionArray 是 multiDimArray21)

	变量 singleDimArray4 为 整数型(4)
	SingleDimensionArraySetter(singleDimArray4)
	断言真(SingleDimensionArrayGetter() 是 singleDimArray4)

	变量 multiDimArray42 为 整数型(4, 2)
	MultiDimensionArraySetter(multiDimArray42)
	断言真(MultiDimensionArrayGetter() 是 multiDimArray42)

	' Checking single dimension array access via variants
	变量 singleDimBooleanArray6 为 逻辑型(6)
	singleDimBooleanArray6(5) = FIRST_BOOLEAN_ELEMENT
	断言真(SingleDimVariantArrayElementGetter(singleDimBooleanArray6, 5) = FIRST_BOOLEAN_ELEMENT)

	变量 singleDimBooleanArray3 为 逻辑型(3)
	SingleDimVariantArrayElementSetter(singleDimBooleanArray3, 2, SECOND_BOOLEAN_ELEMENT)
	断言真(singleDimBooleanArray3(2) = SECOND_BOOLEAN_ELEMENT)

	变量 singleDimByteArray6 为 字节型(6)
	singleDimByteArray6(5) = FIRST_BYTE_ELEMENT
