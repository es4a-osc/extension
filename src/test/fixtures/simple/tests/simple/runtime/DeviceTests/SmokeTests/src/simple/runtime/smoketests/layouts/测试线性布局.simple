' 本示例用于测试横向线性布局的权重分配。
' 子组件宽度设为 0，父容器的可用宽度将按照各组件的权重比例分配。

事件 测试线性布局.初始化()

结束 事件

事件 测试线性布局.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	判断 按键代码
		分支 键码_返回
			切换窗口(主窗口.窗口实例)
	结束 判断
结束 事件

$属性
	$资源 $窗口
	$定义 测试线性布局 $为 窗口
		标题 = "测试线性布局"
		$定义 标签9 $为 标签
			文本 = "1:1 水平："
			内容对齐 = 对齐_垂直居中
		$结束 $定义
		$定义 面板1 $为 面板
			宽度 = 长度_匹配父级
			高度 = "150dp"
			布局.方向 = 布局_方向_水平
			背景颜色 = 颜色_灰
			$定义 标签1 $为 标签
				宽度 = 0
				高度 = 长度_匹配父级
				权重 = 1
				背景颜色 = 颜色_红
				对齐 = 对齐_居中
				文本 = "第一个"
				字体大小 = 10
			$结束 $定义
			$定义 标签2 $为 标签
				宽度 = 0
				高度 = 长度_匹配父级
				权重 = 1
				背景颜色 = 颜色_绿
				对齐 = 对齐_居中
				文本 = "第二个"
				字体大小 = 10
			$结束 $定义
		$结束 $定义
		$定义 标签10 $为 标签
			文本 = "2:1:1 水平："
			内容对齐 = 对齐_垂直居中
		$结束 $定义
		$定义 面板2 $为 面板
			宽度 = 长度_匹配父级
			高度 = "150dp"
			布局.方向 = 布局_方向_水平
			背景颜色 = 颜色_灰
			$定义 标签3 $为 标签
				宽度 = 0
				高度 = 长度_匹配父级
				权重 = 2
				背景颜色 = 颜色_蓝
				对齐 = 对齐_居中
				文本 = "第一个"
				字体大小 = 10
			$结束 $定义
			$定义 标签4 $为 标签
				宽度 = 0
				高度 = 长度_匹配父级
				权重 = 1
				背景颜色 = 颜色_红
				对齐 = 对齐_居中
				文本 = "第二个"
				字体大小 = 10
			$结束 $定义
			$定义 标签5 $为 标签
				宽度 = 0
				高度 = 长度_匹配父级
				权重 = 1
				背景颜色 = 颜色_绿
				对齐 = 对齐_居中
				文本 = "第三个"
				字体大小 = 10
			$结束 $定义
		$结束 $定义
		$定义 标签11 $为 标签
			文本 = "垂直："
			内容对齐 = 对齐_垂直居中
		$结束 $定义
		$定义 面板3 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局.方向 = 布局_方向_垂直
			'android:showDividers="beginning"
			背景颜色 = 颜色_灰
			$定义 标签6 $为 标签
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				背景颜色 = 颜色_绿
				对齐 = 对齐_居中
				文本 = "这是文本"
				字体大小 = 10
			$结束 $定义
			$定义 标签7 $为 标签
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				顶边距 = "10dp"
				背景颜色 = 颜色_黄
				对齐 = 对齐_居中
				文本 = "这是文本"
				字体大小 = 10
			$结束 $定义
			$定义 标签8 $为 标签
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				顶边距 = "10dp"
				背景颜色 = 颜色_红
				对齐 = 对齐_居中
				文本 = "这是文本"
				字体大小 = 10
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
