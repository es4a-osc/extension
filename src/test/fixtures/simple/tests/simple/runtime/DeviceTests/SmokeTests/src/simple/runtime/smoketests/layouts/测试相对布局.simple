事件 测试相对布局.初始化()

结束 事件

事件 测试相对布局.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	判断 按键代码
		分支 键码_返回
			切换窗口(主窗口.窗口实例)
	结束 判断
结束 事件

$属性
	$资源 $窗口
	$定义 测试相对布局 $为 窗口
		标题 = "测试相对布局"
		布局.内容对齐 = 对齐_居中
		$定义 面板1 $为 面板
			布局 = 布局_相对
			宽度 = "400dp"
			高度 = "500dp"
			背景颜色 = 颜色_浅灰
			$定义 按钮1 $为 按钮
				宽度 = "80dp"
				高度 = "40dp"
				对齐父顶边 = 真
				对齐父右边 = 真
				文本 = "父.右上"
			$结束 $定义
			$定义 按钮2 $为 按钮
				宽度 = "80dp"
				高度 = "40dp"
				对齐父顶边 = 真
				对齐父左边 = 真
				文本 = "父.左上"
			$结束 $定义
			$定义 按钮3 $为 按钮
				宽度 = "80dp"
				高度 = "40dp"
				居中于父 = 真
				文本 = "父.居中"
			$结束 $定义
			$定义 按钮4 $为 按钮
				宽度 = "80dp"
				高度 = "40dp"
				对齐父底边 = 真
				对齐父左边 = 真
				文本 = "父.左下"
			$结束 $定义
			$定义 按钮5 $为 按钮
				宽度 = "80dp"
				高度 = "40dp"
				对齐父底边 = 真
				对齐父右边 = 真
				文本 = "父.右下"
			$结束 $定义
			$定义 按钮6 $为 按钮
				宽度 = "80dp"
				高度 = "40dp"
				位于顶边 = 按钮3.标识
				位于左边 = 按钮3.标识
				文本 = "按钮.左上"
			$结束 $定义
			$定义 按钮7 $为 按钮
				宽度 = "80dp"
				高度 = "40dp"
				位于顶边 = 按钮3.标识
				位于右边 = 按钮3.标识
				文本 = "按钮.右上"
			$结束 $定义
			$定义 按钮8 $为 按钮
				宽度 = "80dp"
				高度 = "40dp"
				位于底边 = 按钮3.标识
				位于右边 = 按钮3.标识
				文本 = "按钮.右下"
			$结束 $定义
			$定义 按钮9 $为 按钮
				宽度 = "80dp"
				高度 = "40dp"
				位于底边 = 按钮3.标识
				位于左边 = 按钮3.标识
				文本 = "按钮.左下"
			$结束 $定义
			$定义 按钮10 $为 按钮
				宽度 = "80dp"
				高度 = "40dp"
				对齐底边 = 按钮3.标识
				位于右边 = 按钮3.标识
				文本 = "按钮.右边"
			$结束 $定义
			$定义 按钮11 $为 按钮
				宽度 = "80dp"
				高度 = "40dp"
				对齐底边 = 按钮3.标识
				位于左边 = 按钮3.标识
				文本 = "按钮.左边"
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
