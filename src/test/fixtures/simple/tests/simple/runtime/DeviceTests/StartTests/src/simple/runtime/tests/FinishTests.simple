' Finish screen of device tests.

事件 PrevButton.被单击()
	StartTests.PrevTest()
结束 事件

事件 ExitButton.被单击()
	终止()
结束 事件

$属性
	$资源 $窗口
	$定义 FinishTests $为 窗口
		布局 = 1
		布局.方向 = 1
		标题 =  "冒烟测试 - 完成"
		$定义 TopPanel $为 面板
			布局 = 1
			布局.方向 = 0
			背景颜色 = &HFF000000
			宽度 = -2
			$定义 PrevButton $为 按钮
				文本 = "上一个"
			$结束 $定义
			$定义 ExitButton $为 按钮
				文本 = "退出"
			$结束 $定义
		$结束 $定义
		$定义 InstructionsLabel $为 标签
			文本 = "... 完成组件冒烟测试。"
		$结束 $定义
	$结束 $定义
$结束 $属性
