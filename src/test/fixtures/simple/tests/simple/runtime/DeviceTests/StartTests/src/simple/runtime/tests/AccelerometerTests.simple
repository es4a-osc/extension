' Tests Accelerometer component.

事件 PrevButton.被单击()
	StartTests.PrevTest()
结束 事件

事件 NextButton.被单击()
	StartTests.NextTest()
结束 事件

事件 ExitButton.被单击()
	终止()
结束 事件

事件 Accelerometer.加速度改变(xAccel 为 单精度小数型, yAccel 为 单精度小数型, zAccel 为 单精度小数型)
	XLabel.文本 = "x 加速度：" & xAccel
	YLabel.文本 = "y 加速度：" & yAccel
	ZLabel.文本 = "z 加速度：" & zAccel
结束 事件

事件 Accelerometer.摇晃()
	ShakeLabel.文本 = "摇晃起作用。"
结束 事件

$属性
	$资源 $窗口
	$定义 AccelerometerTests $为 窗口
		布局 = 1
		布局.方向 = 1
		标题 = "测试 - 加速度传感器"
		$定义 TopPanel $为 面板
			布局 = 1
			布局.方向 = 0
			背景颜色 = &HFF000000
			宽度 = -2
			$定义 PrevButton $为 按钮
				文本 = "上一个"
			$结束 $定义
			$定义 NextButton $为 按钮
				文本 = "下一个"
			$结束 $定义
			$定义 ExitButton $为 按钮
				文本 = "退出"
			$结束 $定义
		$结束 $定义
		$定义 Accelerometer $为 加速度传感器
		$结束 $定义
		$定义 XLabel $为 标签
			文本 = "x 加速度：n/a"
		$结束 $定义
		$定义 YLabel $为 标签
			文本 = "y 加速度：n/a"
		$结束 $定义
		$定义 ZLabel $为 标签
			文本 = "z 加速度：n/a"
		$结束 $定义
		$定义 ShakeLabel $为 标签
			文本 = "摇摇我！"
		$结束 $定义
	$结束 $定义
$结束 $属性
