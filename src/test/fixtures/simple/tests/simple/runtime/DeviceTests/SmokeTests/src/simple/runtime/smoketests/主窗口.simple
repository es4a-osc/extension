静态 变量 静态整数 为 整数型
静态 变量 窗口实例 为 窗口
变量 成_按下时间 为 长整数型
变量 成_窗口列表 为 哈希表

事件 主窗口.加载()
	' 正确
	静态整数 = 100

	' 模拟测试，报错
	' 窗口实例 = 本对象

	' 模拟测试，报错
	' 成_按下时间 = 100
结束 事件

事件 主窗口.初始化()
	窗口实例 = 本对象
	成_窗口列表 = 创建 哈希表
	
	' 组件
	列表框1.添加项目("组件：")
	列表框1.添加项目(" - 计时器")
	列表框1.添加项目(" - 音频播放器")
	列表框1.添加项目(" - 消息传递器")
	列表框1.添加项目(" - 弹出菜单")

	' 布局
	列表框1.添加项目("布局：")
	列表框1.添加项目(" - 线性布局")
	列表框1.添加项目(" - 表格布局")
	列表框1.添加项目(" - 单帧布局")
	列表框1.添加项目(" - 相对布局")
	列表框1.添加项目(" - 绝对布局")
	列表框1.添加项目(" - 局部布局")
	列表框1.添加项目(" - 布局对照")

	' 容器组件
	列表框1.添加项目("容器组件：")
	列表框1.添加项目(" - 面板")
	列表框1.添加项目(" - 水平滚动框")
	列表框1.添加项目(" - 垂直滚动框")

	' 可视组件
	列表框1.添加项目("可视组件：")
	' 文本组件
	列表框1.添加项目(" - 标签")
	列表框1.添加项目(" - 按钮")
	列表框1.添加项目(" - 单选框")
	列表框1.添加项目(" - 复选框")
	列表框1.添加项目(" - 编辑框")
	列表框1.添加项目(" - 密码编辑框")
	' 图片组件
	列表框1.添加项目(" - 图片框")
	' 进度组件
	列表框1.添加项目(" - 进度圈")
	列表框1.添加项目(" - 水平进度条")
	列表框1.添加项目(" - 水平滑块条")
	列表框1.添加项目(" - 垂直滑块条")
	' 其它组件
	列表框1.添加项目(" - 列表框")
	列表框1.添加项目(" - 单选列表框")
	列表框1.添加项目(" - 多选列表框")
	列表框1.添加项目(" - 下拉列表框")
	' 其它组件
	列表框1.添加项目(" - 画板")
	列表框1.添加项目(" - 网页浏览框")
	列表框1.添加项目(" - 自定义组件")

	' 对象
	列表框1.添加项目("对象：")
	列表框1.添加项目(" - JSON操作")
	列表框1.添加项目(" - HTTP请求")
	列表框1.添加项目(" - 多线程")
	列表框1.添加项目(" - 后台服务")

	' 功能
	列表框1.添加项目("功能：")
	列表框1.添加项目(" - 程序")
	列表框1.添加项目(" - RES资源")
	列表框1.添加项目(" - 对话框")
	列表框1.添加项目(" - 广播")

	' 其它
	列表框1.添加项目("其它：")
	列表框1.添加项目(" - 重载")
	列表框1.添加项目(" - 跨空间")
	列表框1.添加项目(" - 其它")
结束 事件

事件 主窗口.切换完毕()
	' 列表框需要焦点，否则无法响应事件
	列表框1.获取焦点()
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码  = 键码_返回 则
		如果 取现行时间戳() - 成_按下时间 > 2000 则
			成_按下时间 = 取现行时间戳()
			显示提示框("再按一次退出...")
		否则
			终止()
		结束 如果
	结束 如果
结束 事件

事件 列表框1.项目被单击(项目索引 为 整数型)
	' 项目文本
	变量 局_项目文本 为 文本型
	局_项目文本 = 列表框1.取项目文本(项目索引)

	' 取对应窗口
	变量 局_切换窗口 为 变体型
	如果 成_窗口列表.是否包含键(局_项目文本) 则
		' 注意哈希表返回空，可以通过“类型检验 局_切换窗口 是 窗口”来判断是否是窗口对象
		局_切换窗口 = 成_窗口列表.取值(局_项目文本)
	否则
		' 实例化窗口
		判断 局_项目文本
			' 组件
			分支 " - 计时器"
				局_切换窗口 = 创建 smoketests.components.测试计时器
			分支 " - 音频播放器"
				局_切换窗口 = 创建 smoketests.components.测试音频播放器
			分支 " - 消息传递器"
				局_切换窗口 = 创建 smoketests.components.测试消息传递器
			'分支 " - 弹出菜单"
			'	局_切换窗口 = 创建 测试弹出菜单


			' 布局
			分支 " - 线性布局"
				局_切换窗口 = 创建 smoketests.layouts.测试线性布局
			分支 " - 表格布局"
				局_切换窗口 = 创建 smoketests.layouts.测试表格布局
			分支 " - 单帧布局"
				局_切换窗口 = 创建 smoketests.layouts.测试单帧布局
			分支 " - 相对布局"
				局_切换窗口 = 创建 smoketests.layouts.测试相对布局
			分支 " - 绝对布局"
				局_切换窗口 = 创建 smoketests.layouts.测试绝对布局
			分支 " - 局部布局"
				局_切换窗口 = 创建 smoketests.layouts.测试局部布局
			分支 " - 布局对照"
				局_切换窗口 = 创建 smoketests.layouts.布局对照

			' 容器组件
			分支 " - 面板"
				局_切换窗口 = 创建 smoketests.containers.测试面板
			分支 " - 水平滚动框"
				局_切换窗口 = 创建 smoketests.containers.测试水平滚动框
			分支 " - 垂直滚动框"
				局_切换窗口 = 创建 smoketests.containers.测试垂直滚动框

			' 可视组件
			' 文本组件
			分支 " - 标签"
				局_切换窗口 = 创建 smoketests.visuals.测试标签
			分支 " - 按钮"
				局_切换窗口 = 创建 smoketests.visuals.测试按钮
			分支 " - 单选框"
				局_切换窗口 = 创建 smoketests.visuals.测试单选框
			分支 " - 复选框"
				局_切换窗口 = 创建 smoketests.visuals.测试复选框
			分支 " - 编辑框"
				局_切换窗口 = 创建 smoketests.visuals.测试编辑框
			分支 " - 密码编辑框"
				局_切换窗口 = 创建 smoketests.visuals.测试密码编辑框
			' 图片组件
			分支 " - 图片框"
				局_切换窗口 = 创建 smoketests.visuals.测试图片框
			' 进度组件
			分支 " - 进度圈"
				局_切换窗口 = 创建 smoketests.visuals.测试进度圈
			分支 " - 水平进度条"
				局_切换窗口 = 创建 smoketests.visuals.测试水平进度条
			分支 " - 水平滑块条"
				局_切换窗口 = 创建 smoketests.visuals.测试水平滑块条
			分支 " - 垂直滑块条"
				局_切换窗口 = 创建 smoketests.visuals.测试垂直滑块条
			' 列表组件
			分支 " - 列表框"
				局_切换窗口 = 创建 smoketests.visuals.测试列表框
			分支 " - 单选列表框"
				局_切换窗口 = 创建 smoketests.visuals.测试单选列表框
			分支 " - 多选列表框"
				局_切换窗口 = 创建 smoketests.visuals.测试多选列表框
			分支 " - 下拉列表框"
				局_切换窗口 = 创建 smoketests.visuals.测试下拉列表框
			' 其它组件
			分支 " - 画板"
				局_切换窗口 = 创建 smoketests.visuals.测试画板
			分支 " - 网页浏览框"
				局_切换窗口 = 创建 smoketests.visuals.测试网页浏览框
			分支 " - 自定义组件"
				局_切换窗口 = 创建 smoketests.visuals.测试自定义组件


			' 对象
			分支 " - JSON操作"
				局_切换窗口 = 创建 smoketests.objects.测试JSON操作
			分支 " - HTTP请求"
				局_切换窗口 = 创建 smoketests.objects.测试HTTP请求
			分支 " - 多线程"
				局_切换窗口 = 创建 smoketests.objects.测试线程
			分支 " - 后台服务"
				局_切换窗口 = 创建 smoketests.objects.测试服务


			' 功能
			分支 " - 程序"
				局_切换窗口 = 创建 smoketests.functions.测试程序
			分支 " - 对话框"
				局_切换窗口 = 创建 smoketests.functions.测试对话框
			分支 " - RES资源"
				局_切换窗口 = 创建  smoketests.functions.测试RES资源
			分支 " - 广播"
				局_切换窗口 = 创建 smoketests.functions.测试广播

			
			' 其它
			分支 " - 重载"
				局_切换窗口 = 创建 smoketests.others.测试重载
			分支 " - 跨空间"
				局_切换窗口 = 创建 simple.test.跨空间窗口
			分支 " - 其它"
				局_切换窗口 = 创建 smoketests.others.测试其它
		结束 判断

		如果 局_切换窗口 = 空 则
			显示提示框(局_项目文本 & "，该项尚未注册！")
			退出 事件
		结束 如果

		' 记录实例化的窗口
		成_窗口列表.加入(局_项目文本, 局_切换窗口)
	结束 如果

	' 切换到目标窗口
	切换窗口(局_切换窗口)
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "冒烟测试"
		$定义 列表框1 $为 列表框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
