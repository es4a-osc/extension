变量 成_按钮集合 为 集合

事件 测试水平滚动框.初始化()
	' 创建集合对象
	成_按钮集合 = 创建 集合
结束 事件

事件 测试水平滚动框.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	判断 按键代码
		分支 键码_返回
			切换窗口(主窗口.窗口实例)
	结束 判断
结束 事件

事件 按钮1.被单击()
	变量 局_按钮 为 按钮
	局_按钮 = 创建 按钮 位于 面板2
	成_按钮集合.加入(局_按钮)
	局_按钮.文本 = "动态加入" & 成_按钮集合.计数
	事件转移(局_按钮, 按钮3)
结束 事件

事件 按钮2.被单击()
	如果 成_按钮集合.计数 > 0 则
		变量 局_按钮 为 按钮
		局_按钮 = 成_按钮集合.项目(0)
		成_按钮集合.删除(0)
		局_按钮.销毁()
	否则
		弹出确认框("提示", "已无动态加入按钮了...", "确定")
	结束 如果
结束 事件

事件 按钮3.被单击()
	变量 局_事件组件 为 按钮
	局_事件组件 = 取事件组件()
	弹出提示框("[#" & 局_事件组件.标识  & " - " & 局_事件组件.文本  & "] 被单击！")
结束 事件

事件 水平滚动框1.被滚动(滚动距离 为 整数型, 是否到边 为 逻辑型)
	输出信息(取包名(), "水平滚动框1.被滚动(滚动距离=" & 滚动距离 & ", 是否到边=" & 是否到边 & ")")
结束 事件

事件 按钮4.被单击()
	弹出提示框("[#" & 按钮4.标识  & " - " & 按钮4.文本  & "] 被单击！")
结束 事件

事件 按钮5.被单击()
	弹出提示框("[#" & 按钮5.标识  & " - " & 按钮5.文本  & "] 被单击！")
结束 事件
$属性
	$资源 $窗口
	$定义 测试水平滚动框 $为 窗口
		标题 = "测试水平滚动框"
		$定义 面板1 $为 面板
			宽度 = 长度_匹配父级
			布局.方向 = 布局_方向_水平
			$定义 按钮1 $为 按钮
				文本 = "添加"
			$结束 $定义
			$定义 按钮2 $为 按钮
				文本 = "删除"
			$结束 $定义
			$定义 按钮3 $为 按钮
				文本 = "事件"
				可视 = 假
			$结束 $定义
		$结束 $定义
		$定义 水平滚动框1 $为 水平滚动框
			宽度 = 长度_匹配父级
			$定义 面板2 $为 面板
				宽度 = 长度_匹配父级
				布局.方向 = 布局_方向_水平
				布局.内容对齐 = 对齐_垂直居中
				$定义 按钮4 $为 按钮
					文本 = "设计加入1"
				$结束 $定义
				$定义 按钮5 $为 按钮
					文本 = "设计加入2"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
