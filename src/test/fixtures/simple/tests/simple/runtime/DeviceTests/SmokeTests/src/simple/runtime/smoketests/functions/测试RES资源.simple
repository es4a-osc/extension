
事件 测试RES资源.初始化()
	' 为演示和注释，将相关图片属性放到这设置
	' 来自系统：android.R.drawable.sym_def_app_icon
	图片框1.图片 = 17301651
	' 来自项目：assets\android.png
	图片框2.图片 = "android.png"
	' 来自项目：res\drawable\es4a.png
	图片框3.图片 = R.drawable_es4a
	' 来自项目：res\drawable\icon.png
	图片框4.图片 = "@drawable/icon"
	' 来自项目：res\drawable\login.9.png 九宫图片
	标签1.背景图片 = "@drawable/login"
	' 来自项目：res\drawable\wait.xml 指定背景样式，实现圆角矩形
	标签2.背景图片 = "@drawable/wait"
	' 来自项目：res\drawable\selctor_btn.xml 指定背景样式，实现按钮正常和按下效果
	按钮1.背景图片 = "@drawable/wait"
结束 事件

事件 测试RES资源.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	判断 按键代码
		分支 键码_返回
			切换窗口(主窗口.窗口实例)
	结束 判断
结束 事件

$属性
	$资源 $窗口
	$定义 测试RES资源 $为 窗口
		标题 = "测试RES资源"
		布局.内容对齐 = 对齐_水平居中
		$定义 图片框1 $为 图片框
			宽度 = 长度_适应内容
			高度 = 长度_适应内容
			顶边距 = "10dp"
		$结束 $定义
		$定义 图片框2 $为 图片框
			宽度 = "48dp"
			高度 = "64dp"
			顶边距 = "10dp"
		$结束 $定义
		$定义 图片框3 $为 图片框
			宽度 = 长度_适应内容
			高度 = 长度_适应内容
			顶边距 = "10dp"
		$结束 $定义
		$定义 图片框4 $为 图片框
			宽度 = "72dp"
			高度 = "72dp"
			顶边距 = "10dp"
		$结束 $定义
		$定义 标签1 $为 标签
			宽度 = "80dp"
			高度 = "40dp"
			顶边距 = "10dp"
			内容对齐 = 对齐_居中
			文本 = "标签1"
			文本颜色 = 颜色_白
		$结束 $定义
		$定义 标签2 $为 标签
			宽度 = "80dp"
			高度 = "40dp"
			顶边距 = "10dp"
			内容对齐 = 对齐_居中
			文本 = "标签2"
			文本颜色 = 颜色_白
		$结束 $定义
		$定义 按钮1 $为 按钮
			顶边距 = "10dp"
			宽度 = "80dp"
			高度 = "40dp"
			文本 = "按钮1"
			文本颜色 = 颜色_白
		$结束 $定义
	$结束 $定义
$结束 $属性
