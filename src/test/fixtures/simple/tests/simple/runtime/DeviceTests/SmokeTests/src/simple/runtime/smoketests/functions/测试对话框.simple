变量 成_进度框 为 对象
变量 成_计数 为 整数型

事件 测试对话框.初始化()

结束 事件

事件 测试对话框.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	判断 按键代码
		分支 键码_返回
			切换窗口(主窗口.窗口实例)
	结束 判断
结束 事件

事件 按钮1.被单击()
	变量 局_数组 为 整数型(2)
	局_数组(3) = 100

	' 测试确认框是否可以在错误语句中使用
	位于 错误
		分支 否则
			弹出确认框("确认框", "信息内容...", "确认")
	结束 错误
结束 事件

事件 按钮2.被单击()
	显示提示框("是否=" & 弹出是否框("是否框", "信息内容...", "是", "否"))
结束 事件

事件 按钮3.被单击()
	变量 局_项目文本 为 文本型(3)
	局_项目文本(0) = "江苏"
	局_项目文本(1) = "安徽"
	局_项目文本(2) = "上海"
	显示提示框("单选=" & 弹出单选框("单选框", 局_项目文本, 0))
结束 事件

事件 按钮4.被单击()
	变量 局_项目文本 为 文本型(3)
	局_项目文本(0) = "江苏"
	局_项目文本(1) = "安徽"
	局_项目文本(2) = "上海"

	变量 局_项目状态 为 逻辑型(3)
	局_项目状态(0) = 真
	局_项目状态(1) = 假
	局_项目状态(2) = 真

	局_项目状态 = 弹出多选框("多选框", 局_项目文本, 局_项目状态)
	如果 局_项目状态 = 空 则
		显示提示框("多选：点击取消...")
	否则
		显示提示框("多选：\n0=" & 局_项目状态(0) & "\n1=" & 局_项目状态(1) & "\n2=" & 局_项目状态(2))
	结束 如果
结束 事件


事件 按钮5.被单击()
	显示提示框("输入：" & 弹出输入框("输入框", "单行密码输入...", 假, 输入模式_密码))
结束 事件

事件 按钮6.被单击()
	成_进度框 = 弹出进度框("进度框", "加载中...")
	成_计数 = 0
	计时器1.启用 = 真
结束 事件

事件 计时器1.计时()
	如果 成_计数 >= 6 则
		计时器1.启用 = 假
		关闭进度框(成_进度框)
		成_进度框 = 空
	否则
		成_计数 = 成_计数 + 1
		置进度框信息(成_进度框, "计数=" & 成_计数)
	结束 如果
结束 事件

事件 按钮7.被单击()
	' 局部布局 是 窗口单元
	变量 局_局部布局 为 simple.runtime.smoketests.layouts.局部布局
	局_局部布局 = 创建 simple.runtime.smoketests.layouts.局部布局
	局_局部布局.编辑文本 = "初始测试文本！"
	显示提示框("信息框：\n是否=" & 弹出对话框("信息框", 局_局部布局, "是", "否") & "\n编辑文本=" & 局_局部布局.编辑文本)
结束 事件


$属性
	$资源 $窗口
	$定义 测试对话框 $为 窗口
		标题 = "测试对话框"
		$定义 按钮1 $为 按钮
			文本 = "确认框"
		$结束 $定义
		$定义 按钮2 $为 按钮
			文本 = "是否框"
		$结束 $定义
		$定义 按钮3 $为 按钮
			文本 = "单选框"
		$结束 $定义
		$定义 按钮4 $为 按钮
			文本 = "多选框"
		$结束 $定义
		$定义 按钮5 $为 按钮
			文本 = "输入框"
		$结束 $定义
		$定义 按钮6 $为 按钮
			文本 = "进度框"
		$结束 $定义
		$定义 计时器1 $为 计时器
			启用 = 假
			间隔 = 1000
		$结束 $定义
		$定义 按钮7 $为 按钮
			文本 = "局部对话框"
		$结束 $定义
	$结束 $定义
$结束 $属性
