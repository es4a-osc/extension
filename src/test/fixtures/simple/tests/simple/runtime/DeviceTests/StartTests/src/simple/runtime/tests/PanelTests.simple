' Test Panel component container.

事件 PrevButton.被单击()
	StartTests.PrevTest()
结束 事件

事件 NextButton.被单击()
	StartTests.NextTest()
结束 事件

事件 ExitButton.被单击()
	终止()
结束 事件

$属性
	$资源 $窗口
	$定义 PanelTests $为 窗口
		布局 = 1
		布局.方向 = 1
		滚动 = 真
		标题 = "测试 - 面板"
		$定义 TopPanel $为 面板
			布局 = 1
			布局.方向 = 0
			背景颜色 = &HFF000000
			宽度 = -2
			$定义 PrevButton $为 按钮
				文本 = "上一个"
			$结束 $定义
			$定义 NextButton $为 按钮
				文本 = "下一个"
			$结束 $定义
			$定义 ExitButton $为 按钮
				文本 = "退出"
			$结束 $定义
		$结束 $定义
		$定义 Label1 $为 标签
			文本 = "绿色 100(高)x200(宽) 面板："
		$结束 $定义
		$定义 Panel1 $为 面板
			背景颜色 = &HFF00FF00
			布局 = 1
			布局.方向 = 1
			高度 = 100
			宽度 = 200
		$结束 $定义
	$结束 $定义
$结束 $属性
