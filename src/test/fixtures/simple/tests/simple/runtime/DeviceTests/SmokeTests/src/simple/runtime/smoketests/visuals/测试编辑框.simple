
事件 测试编辑框.初始化()
	' 让图标大小和字体大小一致
	编辑框21.置左边图标("@drawable/icon", 编辑框21.字体大小, 编辑框21.字体大小)
	编辑框21.置图标填充(2)
结束 事件

事件 测试编辑框.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	判断 按键代码
		分支 键码_返回
			切换窗口(主窗口.窗口实例)
	结束 判断
结束 事件

事件 编辑框1.获得焦点()
	编辑框1.文本 = "获得焦点"
结束 事件

事件 编辑框1.失去焦点()
	编辑框1.文本 = "失去焦点"
结束 事件

事件 编辑框2.文本改变(文本内容 为 文本型, 传址 是否接受 为 逻辑型)
	编辑框2.文本颜色 = &HFF00FF00

	变量 局_整数内容 为 整数型
	局_整数内容 = 文本内容
	是否接受 = 真

	位于 错误
		分支 转换错误
			'日志输出.输出警告(取包名() & "/测试编辑框", "转换失败，文本内容：" & 文本内容)
			是否接受 = 假
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 测试编辑框 $为 窗口
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		标题 = "测试编辑框"
		$定义 编辑框1 $为 编辑框
			文本 = "焦点测试"
		$结束 $定义
		$定义 编辑框2 $为 编辑框
			文本 = "123"
			文本颜色 = &HFFFF0000
		$结束 $定义
		$定义 编辑框3 $为 编辑框
			文本 = "文本靠右"
			内容对齐 = 对齐_右
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 编辑框4 $为 编辑框
			文本 = "绿色背景"
			背景颜色 = &HFF00FF00
		$结束 $定义
		$定义 编辑框5 $为 编辑框
			文本 = "禁用"
			启用 = 假
		$结束 $定义
		$定义 编辑框6 $为 编辑框
			文本 = "粗体"
			字体加粗 = 真
		$结束 $定义
		$定义 编辑框7 $为 编辑框
			文本 = "斜体"
			字体倾斜 = 真
		$结束 $定义
		$定义 编辑框8 $为 编辑框
			文本 = "大文本"
			字体大小 = 20
		$结束 $定义
		$定义 编辑框9 $为 编辑框
			文本 = "等宽文本：wiwiw"
			字体类型 = 字体类型_等宽
		$结束 $定义
		$定义 编辑框20 $为 编辑框
			文本 = "绿色文本"
			文本颜色 = &HFF00FF00
		$结束 $定义
		$定义 编辑框21 $为 编辑框
			文本 = "左边带图标"
		$结束 $定义
	$结束 $定义
$结束 $属性
