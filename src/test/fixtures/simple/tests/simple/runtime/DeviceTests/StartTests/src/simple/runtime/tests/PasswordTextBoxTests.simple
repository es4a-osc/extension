' Tests PasswordTextBox component.

事件 PrevButton.被单击()
	StartTests.PrevTest()
结束 事件

事件 NextButton.被单击()
	StartTests.NextTest()
结束 事件

事件 ExitButton.被单击()
	终止()
结束 事件

事件 PasswordTextBox0.获得焦点()
	PasswordTextBox0.文本 = "获得焦点"
结束 事件

事件 PasswordTextBox0.失去焦点()
	PasswordTextBox0.文本 = "失去焦点"
结束 事件

$属性
	$资源 $窗口
	$定义 PasswordTextBoxTests $为 窗口
		布局 = 1
		布局.方向 = 1
		滚动 = 真
		标题 = "测试 - 密码编辑框"
		$定义 TopPanel $为 面板
			布局 = 1
			布局.方向 = 0
			背景颜色 = &HFF000000
			宽度 = -2
			$定义 PrevButton $为 按钮
				文本 = "上一个"
			$结束 $定义
			$定义 NextButton $为 按钮
				文本 = "下一个"
			$结束 $定义
			$定义 ExitButton $为 按钮
				文本 = "退出"
			$结束 $定义
		$结束 $定义
		$定义 PasswordTextBox0 $为 密码编辑框
			文本 = "焦点测试"
		$结束 $定义
		$定义 PasswordTextBox1 $为 密码编辑框
			文本 = "文本右边"
			内容对齐 = 2
			宽度 = -2
		$结束 $定义
		$定义 PasswordTextBox2 $为 密码编辑框
			文本 = "绿色背景"
			背景颜色 = &HFF00FF00
		$结束 $定义
		$定义 PasswordTextBox3 $为 密码编辑框
			文本 = "禁用"
			启用 = 假
		$结束 $定义
		$定义 PasswordTextBox4 $为 密码编辑框
			文本 = "粗体"
			字体加粗 = 真
		$结束 $定义
		$定义 PasswordTextBox5 $为 密码编辑框
			文本 = "斜体"
			字体倾斜 = 真
		$结束 $定义
		$定义 PasswordTextBox6 $为 密码编辑框
			文本 = "大文本"
			字体大小 = 20
		$结束 $定义
		$定义 PasswordTextBox7 $为 密码编辑框
			文本 = "等宽字体文本：wiwiw"
			字体类型 = 3
		$结束 $定义
		$定义 PasswordTextBox8 $为 密码编辑框
			文本 = "绿色文本"
			文本颜色 = &HFF00FF00
		$结束 $定义
	$结束 $定义
$结束 $属性
