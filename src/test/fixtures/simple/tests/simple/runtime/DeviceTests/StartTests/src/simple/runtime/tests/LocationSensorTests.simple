' Tests LocationSensor component.

事件 PrevButton.被单击()
	StartTests.PrevTest()
结束 事件

事件 NextButton.被单击()
	StartTests.NextTest()
结束 事件

事件 ExitButton.被单击()
	终止()
结束 事件

事件 Location.位置改变(latitude 为 双精度小数型, longitude 为 双精度小数型, altitude 为 双精度小数型)
	LatitudeLabel.文本 = "Latitude: " & latitude
	LongitudeLabel.文本 = "Longitude: " & longitude
	AltitudeLabel.文本 = "Altitude: " & altitude
	AddressLabel.文本 = "Address: " & Location.当前地址
结束 事件

$属性
	$资源 $窗口
	$定义 LocationSensorTests $为 窗口
		布局 = 1
		布局.方向 = 1
		标题 = "测试 - 位置传感器"
		$定义 TopPanel $为 面板
			布局 = 1
			布局.方向 = 0
			背景颜色 = &HFF000000
			宽度 = -2
			$定义 PrevButton $为 按钮
				文本 = "上一个"
			$结束 $定义
			$定义 NextButton $为 按钮
				文本 = "下一个"
			$结束 $定义
			$定义 ExitButton $为 按钮
				文本 = "退出"
			$结束 $定义
		$结束 $定义
		$定义 Location $为 位置传感器
		$结束 $定义
		$定义 LatitudeLabel $为 标签
			文本 = "Latitude: 0"
		$结束 $定义
		$定义 LongitudeLabel $为 标签
			文本 = "Longitude: 0"
		$结束 $定义
		$定义 AltitudeLabel $为 标签
			文本 = "Altitude: 0"
		$结束 $定义
		$定义 AddressLabel $为 标签
			文本 = "Address: "
		$结束 $定义
	$结束 $定义
$结束 $属性
