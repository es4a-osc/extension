
事件 测试单选框.初始化()

结束 事件

事件 测试单选框.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	判断 按键代码
		分支 键码_返回
			切换窗口(主窗口.窗口实例)
	结束 判断
结束 事件

事件 单选框1.获得焦点()
	单选框1.文本 = "获得焦点"
结束 事件

事件 单选框1.失去焦点()
	单选框1.文本 = "失去焦点"
结束 事件

事件 单选框2.状态改变()
	如果 单选框2.选中 则
		单选框2.文本 = "选中"
	否则
		单选框2.文本 = "未选中"
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 测试单选框 $为 窗口
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		标题 = "测试单选框"
		$定义 单选框1 $为 单选框
			文本 = "焦点测试"
		$结束 $定义
		$定义 单选框2 $为 单选框
			文本 = "选中我！"
		$结束 $定义
		$定义 单选框3 $为 单选框
			文本 = "文本靠右(没反应)"
			对齐 = 对齐_右
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 单选框4 $为 单选框
			文本 = "绿色背景"
			背景颜色 = &HFF00FF00
		$结束 $定义
		$定义 单选框5 $为 单选框
			文本 = "禁用"
			启用 = 假
		$结束 $定义
		$定义 单选框6 $为 单选框
			文本 = "粗体"
			字体加粗 = 真
		$结束 $定义
		$定义 单选框7 $为 单选框
			文本 = "斜体"
			字体倾斜 = 真
		$结束 $定义
		$定义 单选框8 $为 单选框
			文本 = "大文本"
			字体大小 = 20
		$结束 $定义
		$定义 单选框9 $为 单选框
			文本 = "等宽字体文本：wiwiw"
			字体类型 = 字体类型_等宽
		$结束 $定义
		$定义 单选框20 $为 单选框
			文本 = "绿色文本"
			文本颜色 = &HFF00FF00
		$结束 $定义
	$结束 $定义
$结束 $属性
