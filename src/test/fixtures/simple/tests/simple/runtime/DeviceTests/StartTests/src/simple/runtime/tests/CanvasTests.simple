' Tests Canvas component.

变量 Lx 为 整数型, Ly 为 整数型

事件 CanvasTests.初始化()
	Lx = -1
	Ly = -1
结束 事件

事件 PrevButton.被单击()
	StartTests.PrevTest()
结束 事件

事件 NextButton.被单击()
	StartTests.NextTest()
结束 事件

事件 ExitButton.被单击()
	终止()
结束 事件

事件 DrawingPad.Touched(x 为 单精度小数型, y 为 单精度小数型)
	如果 Lx >= 0 且 Ly >= 0 则
		DrawingPad.画直线(Lx, Ly, x, y)
	结束 如果
	Lx = x
	Ly = y
结束 事件

$属性
	$资源 $窗口
	$定义 CanvasTests $为 窗口
		布局 = 1
		布局.方向 = 1
		标题 = "测试 - 画板"
		$定义 TopPanel $为 面板
			布局 = 1
			布局.方向 = 0
			背景颜色 = &HFF000000
			宽度 = -2
			$定义 PrevButton $为 按钮
				文本 = "上一个"
			$结束 $定义
			$定义 NextButton $为 按钮
				文本 = "下一个"
			$结束 $定义
			$定义 ExitButton $为 按钮
				文本 = "退出"
			$结束 $定义
		$结束 $定义
		$定义 ButtomPanel $为 面板
			布局 = 3
			高度 = -2
			宽度 = -2
			背景颜色 = &HFF0000FF
			$定义 DrawingPad $为 画板
				背景颜色 = &HFFCCCCCC
				画笔颜色 = &HFF00FF00
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
