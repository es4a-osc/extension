' Tests RadioButton component.

事件 PrevButton.被单击()
	StartTests.PrevTest()
结束 事件

事件 NextButton.被单击()
	StartTests.NextTest()
结束 事件

事件 ExitButton.被单击()
	终止()
结束 事件

事件 RadioButton0.获得焦点()
	RadioButton0.文本 = "获得焦点"
结束 事件

事件 RadioButton0.失去焦点()
	RadioButton0.文本 = "失去焦点"
结束 事件

事件 RadioButton1.状态改变()
	如果 RadioButton1.选中 则
		RadioButton1.文本 = "已选中"
	否则
		RadioButton1.文本 = "未选中"
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 RadioButtonBoxTests $为 窗口
		布局 = 1
		布局.方向 = 1
		滚动 = 真
		标题 = "测试 - 单选框"
		$定义 TopPanel $为 面板
			布局 = 1
			布局.方向 = 0
			背景颜色 = &HFF000000
			宽度 = -2
			$定义 PrevButton $为 按钮
				文本 = "上一个"
			$结束 $定义
			$定义 NextButton $为 按钮
				文本 = "下一个"
			$结束 $定义
			$定义 ExitButton $为 按钮
				文本 = "退出"
			$结束 $定义
		$结束 $定义
		$定义 RadioButton0 $为 单选框
			文本 = "焦点测试"
		$结束 $定义
		$定义 RadioButton1 $为 单选框
			文本 = "选中我！"
		$结束 $定义
		$定义 RadioButton2 $为 单选框
			文本 = "文本右边"
			内容对齐 = 2
			宽度 = -2
		$结束 $定义
		$定义 RadioButton3 $为 单选框
			文本 = "绿色背景"
			背景颜色 = &HFF00FF00
		$结束 $定义
		$定义 RadioButton4 $为 单选框
			文本 = "禁用"
			启用 = 假
		$结束 $定义
		$定义 RadioButton5 $为 单选框
			文本 = "粗体"
			字体加粗 = 真
		$结束 $定义
		$定义 RadioButton6 $为 单选框
			文本 = "斜体"
			字体倾斜 = 真
		$结束 $定义
		$定义 RadioButton7 $为 单选框
			文本 = "大文本"
			字体大小 = 20
		$结束 $定义
		$定义 RadioButton8 $为 单选框
			文本 = "等宽字体文本：wiwiw"
			字体类型 = 3
		$结束 $定义
		$定义 RadioButton9 $为 单选框
			文本 = "绿色文本"
			文本颜色 = &HFF00FF00
		$结束 $定义
	$结束 $定义
$结束 $属性
