' 重载规则：
' 同名过程或函数的参数个数必须不同，参数类型不同不算重载。

事件 测试重载.初始化()

结束 事件

事件 测试重载.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	判断 按键代码
		分支 键码_返回
			切换窗口(主窗口.窗口实例)
	结束 判断
结束 事件

事件 按钮1.被单击()
	过程1()
结束 事件

事件 按钮2.被单击()
	过程1("参数值1")
结束 事件

事件 按钮3.被单击()
	过程1("参数值1", "参数值2")
结束 事件

过程 过程1()
	弹出提示框("过程1()")
结束 过程

过程 过程1(参数1 为 文本型)
	弹出提示框("过程1(参数1)\n" & "参数1=" & 参数1)
结束 过程

过程 过程1(参数1 为 文本型, 参数2 为 文本型)
	弹出提示框("过程1(参数1,参数1)\n" & "参数1=" & 参数1 & "参数2=" & 参数2)
结束 过程

' 测试重复定义过程
' 过程 过程1()
' 结束 过程

' 测试重复定义过程
' 过程 过程1(参数1 为 整数型)
' 结束 过程

事件 按钮4.被单击()
	函数1()
结束 事件

事件 按钮5.被单击()
	函数1("参数值1")
结束 事件

事件 按钮6.被单击()
	函数1("参数值1", "参数值2")
结束 事件

函数 函数1() 为 文本型
	弹出提示框("函数1()")
	函数1 = "函数1"
结束 函数

函数 函数1(参数1 为 文本型) 为 文本型
	弹出提示框("函数1(参数1)\n" & "参数1=" & 参数1)
	函数1 = "函数1(参数1)"
结束 函数

函数 函数1(参数1 为 文本型, 参数2 为 文本型) 为 文本型
	弹出提示框("函数1(参数1,参数2)\n" & "参数1=" & 参数1 & "参数2=" & 参数2)
	函数1 = "函数1(参数1,参数2)"
结束 函数

' 测试重复定义函数
' 函数 函数1() 为 文本型
' 	弹出提示框("函数1()")
' 	函数1 = "函数1"
' 结束 函数

' 测试重复定义函数
' 函数 函数1(参数1 为 文本型) 为 文本型
' 	弹出提示框("函数1(参数1)\n" & "参数1=" & 参数1)
' 	函数1 = "函数1(参数1)"
' 结束 函数

$属性
	$资源 $窗口
	$定义 测试重载 $为 窗口
		标题 = "测试重载"
		$定义 标签1 $为 标签
			文本 = "过程："
		$结束 $定义
		$定义 面板1 $为 面板
			$定义 按钮1 $为 按钮
				文本 = "过程1()"
			$结束 $定义
			$定义 按钮2 $为 按钮
				文本 = "过程1(参数1)"
			$结束 $定义
			$定义 按钮3 $为 按钮
				文本 = "过程1(参数1,参数2)"
			$结束 $定义
			布局.方向 = 布局_方向_水平
		$结束 $定义
		$定义 标签2 $为 标签
			文本 = "函数："
		$结束 $定义
		$定义 面板2 $为 面板
			布局.方向 = 布局_方向_水平
			$定义 按钮4 $为 按钮
				文本 = "函数1()"
			$结束 $定义
			$定义 按钮5 $为 按钮
				文本 = "函数1(参数1)"
			$结束 $定义
			$定义 按钮6 $为 按钮
				文本 = "函数1(参数1,参数2)"
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
