常量 测试动作1 为 文本型 = "ES4A测试动作1", 测试动作2 为 文本型 = "ES4A测试动作2"

事件 测试广播.初始化()
	' 可以注册多个动作
	广播接收器1.注册动作(测试动作1)
	广播接收器1.注册动作(测试动作2)
结束 事件

事件 测试广播.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	判断 按键代码
		分支 键码_返回
			切换窗口(主窗口.窗口实例)
	结束 判断
结束 事件

事件 广播接收器1.收到广播(收到动作 为 文本型, 广播意图 为 意图)
	变量 局_广播标记 为 文本型, 局_广播参数 为 文本型

	' 这里是通过广播标记区附加值的，也可以通过类型检验区分
	局_广播标记 = 广播意图.取附加("广播标记")
	判断 局_广播标记
		分支 "测试文本"
			局_广播参数 = 广播意图.取附加("广播参数")
		分支 "测试数组"
			局_广播参数 = 连接数组文本(广播意图.取附加("广播参数"), " | ")
		分支 否则
			局_广播参数 = "未知广播标记=" & 局_广播标记
	结束 判断

	编辑框1.加入文本("动作=" & 收到动作 & "\n标记=" & 局_广播标记 & "\n参数=" & 局_广播参数 & "\n\n")
结束 事件

事件 按钮1.被单击()
	变量 局_广播意图 为 意图
	局_广播意图 = 创建 意图
	局_广播意图.置动作(测试动作1)
	局_广播意图.置附加("广播标记", "测试文本")
	局_广播意图.置附加("广播参数", "https://es4a.wsd.cx")
	发送广播(局_广播意图)
结束 事件

事件 按钮2.被单击()
	变量 局_文本数组 为 文本型(4)
	局_文本数组(0) = "https://"
	局_文本数组(1) = "es4a"
	局_文本数组(1) = "wsd"
	局_文本数组(2) = ".cx"

	变量 局_广播意图 为 意图
	局_广播意图 = 创建 意图
	局_广播意图.置动作(测试动作2)
	局_广播意图.置附加("广播标记", "测试数组")
	局_广播意图.置附加("广播参数", 局_文本数组)
	发送广播(局_广播意图)
结束 事件

事件 按钮3.被单击()
	显示提示框("已注册动作：\n" & 连接数组文本(广播接收器1.所有动作, " | "))
结束 事件
$属性
	$资源 $窗口
	$定义 测试广播 $为 窗口
		标题 = "测试广播"
		$定义 广播接收器1 $为 广播接收器
		$结束 $定义
		$定义 按钮3 $为 按钮
			文本 = "已注册动作"
		$结束 $定义
		$定义 按钮1 $为 按钮
			文本 = "发送文本"
		$结束 $定义
		$定义 按钮2 $为 按钮
			文本 = "发送文本数组"
		$结束 $定义
		$定义 编辑框1 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
