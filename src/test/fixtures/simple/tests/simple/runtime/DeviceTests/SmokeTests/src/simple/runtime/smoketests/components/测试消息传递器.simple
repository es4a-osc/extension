常量 消息_整数 为 整数型 = 1, 消息_文本 为 整数型 = 2, 消息_日期 为 整数型 = 3, 消息_文本数组 为 整数型 = 4

事件 测试消息传递器.初始化()

结束 事件

事件 测试消息传递器.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	判断 按键代码
		分支 键码_返回
			切换窗口(主窗口.窗口实例)
	结束 判断
结束 事件

事件 消息传递器1.收到消息(消息标记 为 整数型, 消息载荷 为 变体型)
	' 储存为文本
	变量 局_消息内容 为 文本型

	' 转为文本
	如果 类型检验 消息载荷 是 整数型 则
		局_消息内容 = 消息载荷
	否则如果 类型检验 消息载荷 是 文本型 则
		局_消息内容 = 消息载荷
	否则如果 类型检验 消息载荷 是 日期时间型 则
		局_消息内容 = 格式化时间(消息载荷, "yyyy/MM/dd HH:mm:ss")
	否则如果 类型检验 消息载荷 是 文本型() 则
		局_消息内容 = 连接数组文本(消息载荷, " | ")
	否则
		局_消息内容 = "未知数据类型"
	结束 如果

	' 输出文本
	编辑框1.加入文本("标记=" & 消息标记 & " 内容=" & 局_消息内容 & "\n")
结束 事件

事件 按钮1.被单击()
	消息传递器1.发送消息(消息_整数, 取现行时间戳())
结束 事件

事件 按钮2.被单击()
	消息传递器1.发送消息(消息_文本, 格式化时间(取现行时间(), "yyyy/MM/dd HH:mm:ss") )
结束 事件

事件 按钮3.被单击()
	消息传递器1.发送消息(消息_日期, 取现行时间())
结束 事件

事件 按钮4.被单击()
	变量 局_一维数组 为 文本型(3)
	局_一维数组(0) = "A"
	局_一维数组(1) = "B"
	局_一维数组(2) = "C"
	消息传递器1.发送消息(消息_文本数组, 局_一维数组)
结束 事件
$属性
	$资源 $窗口
	$定义 测试消息传递器 $为 窗口
		标题 = "测试消息传递器"
		$定义 消息传递器1 $为 消息传递器
		$结束 $定义
		$定义 按钮1 $为 按钮
			文本 = "发生整数"
		$结束 $定义
		$定义 按钮2 $为 按钮
			文本 = "发生文本"
		$结束 $定义
		$定义 按钮3 $为 按钮
			文本 = "发送日期"
		$结束 $定义
		$定义 按钮4 $为 按钮
			文本 = "发送文本数组"
		$结束 $定义
		$定义 标签1 $为 标签
			文本 = "收到消息："
		$结束 $定义
		$定义 编辑框1 $为 编辑框
			宽度 = 长度_匹配父级
			提示文本 = "消息文本内容"
			高度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
