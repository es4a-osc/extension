
事件 测试音频播放器.初始化()
	编辑框1.文本 = "https://wsd.myds.me:15244/d/其他/测试/小鳄鱼.mp3"
结束 事件

事件 测试音频播放器.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	判断 按键代码
		分支 键码_返回
			切换窗口(主窗口.窗口实例)
	结束 判断
结束 事件

事件 音频播放器1.错误通知(错误类型 为 整数型, 附加数值 为 整数型)
	如果 按钮1.启用 = 假 则 按钮1.启用 = 真
	编辑框2.文本 = "[" & 取现行时间戳() & "] 错误通知 类型=" & 错误类型 & " 附加数值=" & 附加数值 & "\n" & 编辑框2.文本
结束 事件

事件 音频播放器1.信息通知(信息类型 为 整数型, 附加数值 为 整数型)
	编辑框2.文本 = "[" & 取现行时间戳() & "] 信息通知 类型=" & 信息类型 & " 附加数值=" & 附加数值 & "\n" & 编辑框2.文本
结束 事件

事件 音频播放器1.缓冲更新(百分比例 为 整数型)
	如果 按钮1.启用 = 假 则 按钮1.启用 = 真
	编辑框2.文本 = "[" & 取现行时间戳() & "] 缓冲更新 百分比例=" & 百分比例 & "\n" & 编辑框2.文本
结束 事件

事件 音频播放器1.播放就绪()
	编辑框2.文本 = "[" & 取现行时间戳() & "] 播放就绪" & "\n" & 编辑框2.文本
	编辑框2.文本 = "[" & 取现行时间戳() & "] (自动)播放=" & 音频播放器1.播放() & "\n" & 编辑框2.文本
	按钮3.启用 = 真
	按钮4.启用 = 真
结束 事件

事件 音频播放器1.位置改变()
	编辑框2.文本 = "[" & 取现行时间戳() & "] 位置改变" & "\n" & 编辑框2.文本
结束 事件

事件 音频播放器1.播放结束()
	编辑框2.文本 = "[" & 取现行时间戳() & "] 播放结束" & "\n" & 编辑框2.文本
	按钮2.启用 = 真
	按钮3.启用 = 假
结束 事件

事件 按钮1.被单击()
	编辑框2.文本 = "[" & 取现行时间戳() & "] 打开=" & 音频播放器1.打开(编辑框1.文本) & "，连接中...\n" & 编辑框2.文本
	按钮1.启用 = 假
	按钮2.启用 = 假
	按钮3.启用 = 假
	按钮4.启用 = 假
结束 事件

事件 按钮2.被单击()
	编辑框2.文本 = "[" & 取现行时间戳() & "] 播放=" & 音频播放器1.播放() & "\n" & 编辑框2.文本
	按钮2.启用 = 假
	按钮3.启用 = 真
结束 事件

事件 按钮3.被单击()
	编辑框2.文本 = "[" & 取现行时间戳() & "] 暂停=" & 音频播放器1.暂停() & "\n" & 编辑框2.文本
	按钮2.启用 = 真
	按钮3.启用 = 假
结束 事件

事件 按钮4.被单击()
	编辑框2.文本 = "[" & 取现行时间戳() & "] 停止=" & 音频播放器1.停止() & "\n" & 编辑框2.文本
结束 事件
$属性
	$资源 $窗口
	$定义 测试音频播放器 $为 窗口
		标题 = "测试音频播放器"
		$定义 音频播放器1 $为 音频播放器
		$结束 $定义
		$定义 编辑框1 $为 编辑框
			宽度 = 长度_匹配父级
			提示文本 = "输入音频网络地址或本地路径"
		$结束 $定义
		$定义 面板1 $为 面板
			布局.方向 = 布局_方向_水平
			$定义 按钮1 $为 按钮
				文本 = "打开"
			$结束 $定义
			$定义 按钮2 $为 按钮
				文本 = "播放"
				启用 = 假
			$结束 $定义
			$定义 按钮3 $为 按钮
				文本 = "暂停"
				启用 = 假
			$结束 $定义
			$定义 按钮4 $为 按钮
				文本 = "停止"
				启用 = 假
			$结束 $定义
		$结束 $定义
		$定义 编辑框2 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
