变量 成_按下时间 为 长整数型

事件 窗口1.初始化()

结束 事件

事件 窗口1.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	判断 按键代码
		分支 键码_返回
			如果 取现行时间戳() - 成_按下时间 > 2000 则
				成_按下时间 = 取现行时间戳()
				显示提示框("窗口1：再按一次退出...")
			否则
				终止()
			结束 如果
	结束 判断
结束 事件

$属性
	$资源 $窗口
	$定义 窗口1 $为 窗口
		布局 = 布局_相对
		左填充 = "10dp"
		右填充 = "10dp"
		标题 = "窗口1"
		$定义 编辑框1 $为 编辑框
			居中于父 = 真
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			提示文本 = "编辑框1"
			左边距 = "30dp"
			右边距 = "30dp"
		$结束 $定义
		$定义 标签1 $为 标签
			位于顶边 = 编辑框1.标识
			居中水平 = 真
			底边距 = "40dp"
			宽度 = 长度_适应内容
			高度 = 长度_适应内容
			文本 = "← 我在窗口1 →"
			文本颜色 = 颜色_浅灰
		$结束 $定义
		$定义 图片框1 $为 图片框
			位于顶边 = 标签1.标识
			居中水平 = 真
			宽度 = "64dp"
			高度 = "64dp"
			图片 = "@drawable/icon"
		$结束 $定义
		$定义 编辑框2 $为 编辑框
			位于顶边 = 编辑框1.标识
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			提示文本 = "编辑框2"
			左边距 = "30dp"
			右边距 = "30dp"
		$结束 $定义
		$定义 按钮1 $为 按钮
			位于底边 = 编辑框1.标识
			对齐右边 = 编辑框1.标识
			右边距 = "10dp"
			宽度 = 长度_适应内容
			高度 = 长度_适应内容
			文本 = "按钮1"
		$结束 $定义
		$定义 按钮2 $为 按钮
			位于左边 = 按钮1.标识
			对齐顶边 = 按钮1.标识
			宽度 = 长度_适应内容
			高度 = 长度_适应内容
			文本 = "按钮2"
		$结束 $定义
		$定义 标签2 $为 标签
			居中水平 = 真
			对齐父底边 = 真
			宽度 = 长度_适应内容
			高度 = 长度_适应内容
			底边距 = "20dp"
			文本 = "Simple"
			文本颜色 = 颜色_浅灰
		$结束 $定义
	$结束 $定义
$结束 $属性
