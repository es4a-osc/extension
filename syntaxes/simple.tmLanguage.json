{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Simple",
	"scopeName": "source.simple",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#declarations"
		},
		{
			"include": "#property-section"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#types"
		},
		{
			"include": "#literals"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#punctuation"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#line-continuation"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"begin": "'",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.simple"
						}
					},
					"end": "$",
					"name": "comment.line.apostrophe.simple"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"begin": "\"",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.simple"
						}
					},
					"end": "\"",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.simple"
						}
					},
					"name": "string.quoted.double.simple",
					"patterns": [
						{
							"match": "\\\\(?:[\\\\\"nrt]|u[0-9A-Fa-f]{4})",
							"name": "constant.character.escape.simple"
						}
					]
				}
			]
		},
		"property-section": {
			"patterns": [
				{
					"match": "(?<![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}.])(?:\\$定义|\\$结束|\\$属性|\\$资源|\\$为)(?![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}])",
					"name": "keyword.other.property-section.simple"
				},
				{
					"match": "(?<![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}.])(?:\\$窗口|\\$接口|\\$对象|\\$服务)(?![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}])",
					"name": "storage.type.property-section.simple"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"match": "(?<![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}.])(?:别名|常量|变量|事件|函数|属性|过程)(?![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}])",
					"name": "storage.type.declaration.simple"
				},
				{
					"match": "(?<![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}.])(?:否则如果|触发事件|判断循环|分支|执行|每个|否则|结束|错误|退出|循环|如果|下个|位于|判断|步进|直到|从|则|至)(?![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}])",
					"name": "keyword.control.simple"
				},
				{
					"match": "(?<![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}.])(?:传址|传值|静态)(?![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}])",
					"name": "storage.modifier.simple"
				},
				{
					"match": "(?<![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}.])(?:类型检验|本对象|创建)(?![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}])",
					"name": "keyword.other.expression.simple"
				},
				{
					"match": "^\\s*(获取|设置)(?=\\s*(?:'|$))",
					"captures": {
						"1": {
							"name": "storage.type.accessor.simple"
						}
					}
				}
			]
		},
		"types": {
			"patterns": [
				{
					"match": "(?<![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}.])(?:双精度小数型|单精度小数型|日期时间型|长整数型|短整数型|逻辑型|字节型|整数型|文本型|变体型|对象)(?![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}])",
					"name": "storage.type.simple"
				}
			]
		},
		"literals": {
			"patterns": [
				{
					"match": "(?<![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}.])(?:真|假)(?![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}])",
					"name": "constant.language.boolean.simple"
				},
				{
					"match": "(?<![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}.])(?:空)(?![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}])",
					"name": "constant.language.null.simple"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"match": "(?<![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}.])(?:匹配|取反|异或|且|为|是|非|或)(?![\\p{L}\\p{Nl}\\p{Sc}\\p{Pc}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Cf}])",
					"name": "keyword.operator.word.simple"
				},
				{
					"match": "<>|<=|>=|<<|>>|\\+|-|\\*|/|%|\\\\|\\^|&|=|<|>",
					"name": "keyword.operator.symbol.simple"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"match": ":",
					"name": "punctuation.separator.statement.simple"
				}
			]
		},
		"declarations": {
			"patterns": [
				{
					"captures": {
						"1": {
							"name": "storage.type.declaration.simple"
						},
						"2": {
							"name": "entity.name.function.simple"
						}
					},
					"match": "(?<![\\p{L}\\p{N}_])(函数|过程|事件|属性)\\s+([\\p{L}][\\p{L}\\p{N}_]*(?:\\.[\\p{L}][\\p{L}\\p{N}_]*)?)"
				},
				{
					"captures": {
						"1": {
							"name": "storage.type.declaration.simple"
						},
						"2": {
							"name": "variable.other.definition.simple"
						}
					},
					"match": "(?<![\\p{L}\\p{N}_])(常量|变量)\\s+([\\p{L}][\\p{L}\\p{N}_]*)"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"match": "(?<![\\p{L}\\p{N}_])&H[0-9A-Fa-f]+(?![\\p{L}\\p{N}_])",
					"name": "constant.numeric.hex.simple"
				},
				{
					"match": "(?<![\\p{L}\\p{N}_])[0-9]+(?:\\.[0-9]+(?:[Ee][+-]?[0-9]+)?)?(?![\\p{L}\\p{N}_])",
					"name": "constant.numeric.decimal.simple"
				}
			]
		},
		"line-continuation": {
			"patterns": [
				{
					"match": "_$",
					"name": "punctuation.separator.continuation.simple"
				}
			]
		}
	}
}
